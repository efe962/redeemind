{
  "name": "redeemind",
  "version": "0.2.7",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "sync:version": "node scripts/sync-version.mjs",
    "prepackage": "npm run sync:version",
    "version": "npm run sync:version",
    "build": "npm run build:chromium && npm run build:firefox",
    "build:chromium": "node scripts/build.mjs chromium",
    "build:firefox": "node scripts/build.mjs firefox",
    "package": "npm run build && node scripts/package.mjs",
    "package:chromium": "npm run build:chromium && node scripts/package.mjs chromium",
    "verify:chromium": "node scripts/verify-chromium.mjs",
    "dev": "vite",
    "lint": "eslint .",
    "check:locales": "vite-node scripts/check-locales.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:lib": "vitest run --config vite.coverage.lib.config.ts --coverage",
    "test:mutation": "stryker run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "nanoid": "^5.0.9",
    "tldts": "^6.1.86",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/chrome": "^0.0.270",
    "@types/node": "^22.7.4",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vite": "^8.3.5",
    "vitest": "^2.1.2"
  }
}
